rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /books/{bookId} {
      allow create: if createsOwnDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument() && createsOwnDocument();
    }

    match /readingRecords/{recordId} {
      allow create: if createsOwnDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument() && createsOwnDocument();
    }
  }
}
